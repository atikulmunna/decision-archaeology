# Copy to .env.local for local development. Never commit real values.

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Database (PostgreSQL)
DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI (OpenRouter Auto Router)
OPENROUTER_API_KEY=
# low | medium | high (default medium); each pipeline pass also sets its own tier
OPENROUTER_COST_TIER=medium
# optional comma-separated model patterns, e.g. anthropic/*,openai/gpt-5*
OPENROUTER_ALLOWED_MODELS=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Background jobs (Upstash QStash). Signing keys are required in production.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Attachments (Cloudflare R2)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Optional
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
