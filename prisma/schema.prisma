// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum Tier {
  FREE
  PRO
  POWER
}

enum DomainTag {
  CAREER
  FINANCE
  HEALTH
  RELATIONSHIPS
  CREATIVE
  OTHER
}

enum OutcomeRating {
  MUCH_BETTER
  SLIGHTLY_BETTER
  AS_EXPECTED
  SLIGHTLY_WORSE
  MUCH_WORSE
  TOO_EARLY_TO_TELL
}

enum BiasSeverity {
  MILD
  MODERATE
  STRONG
}

enum AssumptionVerdict {
  HELD
  PARTLY
  DIDNT
}

enum ForecastResolution {
  HAPPENED
  DIDNT
  VOID
}

enum BiasReportStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
}

// What happened at the Devil's Advocate step before sealing (src/lib/devils-advocate.ts).
enum ChallengeOutcome {
  ASKED
  SKIPPED
  UNAVAILABLE
}

// ── Models ─────────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  clerkId     String   @unique
  email       String   @unique
  displayName String?
  avatarUrl   String?
  tier        Tier     @default(FREE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  decisions         DecisionRecord[]
  biasReports       BiasReport[]
  collaborations    CollaboratorShare[] @relation("CollaboratorUser")
  sharedDecisions   CollaboratorShare[] @relation("SharedDecisionOwner")
  fieldNotes        FieldNote[]
  challengeAttempts ChallengeAttempt[]

  @@map("users")
}

model DecisionRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Core fields (LOCKED after 5-min window) ──
  title       String
  summary     String   // LOCKED
  context     String   // LOCKED
  alternatives String  // LOCKED
  chosenOption String  // LOCKED
  reasoning   String   // LOCKED
  isLocked    Boolean  @default(false)
  lockedAt    DateTime?

  // ── Optional fields ──
  values              String?
  uncertainties       String?
  predictedOutcome    String?
  predictedTimeframe  DateTime?
  confidenceLevel     Int?        // 1-10
  domainTag           DomainTag?
  customTags          String[]    @default([])
  attachments         String[]    @default([]) // R2 object keys

  // ── Editable post-lock ──
  supplementaryNotes  String?

  // ── Metadata ──
  isImported  Boolean  @default(false)
  catalogNumber Int?   // per-user DA-0042 number, assigned when a record is finalized or imported
  sealHash    String?   // SHA-256 of buildSealPayload() (src/lib/seal.ts), rewritten on every write that changes sealed fields
  sealedAt    DateTime? // when sealHash was computed; later than the lock deadline means a retroactive seal
  isDraft     Boolean  @default(true)
  draftStartedAt DateTime? // when the draft was first saved; createdAt restarts at finalize
  challengeOutcome ChallengeOutcome? // null: never offered (older records, imports, finalizes that skip the step)
  challengeModel   String?           // the routed model that asked the questions
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outcomes          OutcomeUpdate[]
  collaborators     CollaboratorShare[]
  corrections       CorrectionRequest[]
  assumptionReviews AssumptionReview[]
  forecasts         Forecast[]
  fieldNotes        FieldNote[]
  challengeQuestions ChallengeQuestion[]

  @@unique([userId, catalogNumber])
  @@map("decision_records")
}

// One verdict per assumption split from a decision's sealed uncertainties (src/lib/assumptions.ts).
// A reflection added after sealing, like an outcome: never part of the seal.
model AssumptionReview {
  id         String            @id @default(cuid())
  decisionId String
  decision   DecisionRecord    @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  itemHash   String            // SHA-256 of normalizeAssumption(itemText)
  itemText   String            // snapshot, so a review stays readable if the split rule changes
  verdict    AssumptionVerdict
  note       String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([decisionId, itemHash])
  @@map("assumption_reviews")
}

// Up to 3 yes or no forecasts per decision (src/lib/forecasting.ts). Statement, probability and
// resolveBy lock and are sealed with the decision (seal v2); the resolution stays open.
model Forecast {
  id          String              @id @default(cuid())
  decisionId  String
  decision    DecisionRecord      @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  position    Int                 // 0 to 2
  statement   String
  probability Int                 // 5 to 95, multiple of 5
  resolveBy   DateTime            // midnight UTC of the chosen day
  resolution  ForecastResolution?
  resolvedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([decisionId, position])
  @@map("forecasts")
}

model OutcomeUpdate {
  id           String   @id @default(cuid())
  decisionId   String
  decision     DecisionRecord @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  whatHappened     String
  outcomeRating    OutcomeRating
  lessonsLearned   String?
  createdAt        DateTime @default(now())

  @@map("outcome_updates")
}

model BiasReport {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  status        BiasReportStatus @default(PENDING)
  decisionCount Int
  summary       String?
  findings      Json?            // BiasEntry[]
  calibrationInsight String?
  flaggedFindings Json?          // string[]
  modelsUsed    String[]         @default([]) // models picked by the OpenRouter Auto Router
  completedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime         @default(now())

  @@map("bias_reports")
}

model CollaboratorShare {
  id           String   @id @default(cuid())
  decisionId   String
  decision     DecisionRecord @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  ownerId      String
  owner        User     @relation("SharedDecisionOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  collaboratorId String
  collaborator   User   @relation("CollaboratorUser", fields: [collaboratorId], references: [id], onDelete: Cascade)

  isActive     Boolean  @default(true)
  sharedAt     DateTime @default(now())
  comments     CollaboratorComment[]

  @@unique([decisionId, collaboratorId])
  @@map("collaborator_shares")
}

model CollaboratorComment {
  id        String   @id @default(cuid())
  shareId   String
  share     CollaboratorShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  authorId  String
  content   String
  createdAt DateTime @default(now())

  @@map("collaborator_comments")
}

model CorrectionRequest {
  id           String   @id @default(cuid())
  decisionId   String
  decision     DecisionRecord @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  fieldName    String   // Which locked field has the typo
  originalText String
  correctedText String
  reason       String?
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt    DateTime @default(now())

  @@map("correction_requests")
}

model CheckInReminder {
  id           String   @id @default(cuid())
  decisionId   String
  scheduledFor DateTime
  snoozedUntil DateTime?
  sentAt       DateTime?
  createdAt    DateTime @default(now())

  @@map("check_in_reminders")
}

// Quick, never-locked journal entries (src/lib/field-notes.ts). A note links to at most one decision,
// as evidence or as the note it was promoted from. Never part of any seal.
model FieldNote {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisionId String?
  decision   DecisionRecord? @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  body       String          // 1 to 1000 characters, trimmed
  mood       Int?            // 1 to 5
  energy     Int?            // 1 to 5
  promoted   Boolean         @default(false) // the note this decision was promoted from
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([userId, createdAt])
  @@index([decisionId])
  @@map("field_notes")
}

// Questions the AI asked before sealing, with the owner's answers. Only the challenge route writes
// questions; answers are fixed at finalize. Sealed in da-seal-v3 (src/lib/seal.ts).
model ChallengeQuestion {
  id         String         @id @default(cuid())
  decisionId String
  decision   DecisionRecord @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  position   Int            // 0, 1 or 2
  question   String
  answer     String?        // null: left unanswered
  createdAt  DateTime       @default(now())

  @@unique([decisionId, position])
  @@map("challenge_questions")
}

// Every call that reaches the AI for a challenge, kept apart from drafts so deleting one never
// gives an attempt back. Counts toward the daily cap.
model ChallengeAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("challenge_attempts")
}
